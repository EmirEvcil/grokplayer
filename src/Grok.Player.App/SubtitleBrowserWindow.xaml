<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Grok.Player.App.SubtitleBrowserWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Grok.Player.App.Controls"
    Title="Subtitle browser">
    <Grid
        x:Name="Root"
        Background="#FF101012"
        PointerMoved="EmptyArea_PointerMoved"
        PointerPressed="EmptyArea_PointerPressed"
        PointerReleased="EmptyArea_PointerReleased"
        PointerCaptureLost="EmptyArea_PointerReleased">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Background="{StaticResource GrokChromeBrush}"
            BorderBrush="{StaticResource GrokLineBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="TitleDrag"
                Background="Transparent">
                <TextBlock
                    Margin="12,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource GrokAccentBrush}"
                    Text="Subtitle browser" />
            </Grid>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal">
                <Button
                    Click="Settings_Click"
                    Style="{StaticResource ChromeButton}"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="12" Glyph="&#xE713;" />
                </Button>
                <Button
                    x:Name="PinButton"
                    Click="Pin_Click"
                    Style="{StaticResource ChromeButton}"
                    ToolTipService.ToolTip="Keep above main window">
                    <FontIcon x:Name="PinIcon" FontSize="12" Glyph="&#xE840;" />
                </Button>
                <Button
                    Click="Close_Click"
                    Style="{StaticResource ChromeButton}"
                    ToolTipService.ToolTip="Close">
                    <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Background="{StaticResource GrokChromeBrush}"
            BorderBrush="{StaticResource GrokLineBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Click="NudgeBack_Click" Style="{StaticResource SubIconButton}" ToolTipService.ToolTip="Decrease subtitle sync by 0.5 sec">
                        <FontIcon FontSize="12" Glyph="&#xE100;" />
                    </Button>
                    <Button Click="NudgeForward_Click" Style="{StaticResource SubIconButton}" ToolTipService.ToolTip="Increase subtitle sync by 0.5 sec">
                        <FontIcon FontSize="12" Glyph="&#xE101;" />
                    </Button>
                    <Button Click="SetSync_Click" Style="{StaticResource SubIconButton}" ToolTipService.ToolTip="Set subtitle sync">
                        <FontIcon FontSize="12" Glyph="&#xE916;" />
                    </Button>
                    <Button Click="ResetAllToSelected_Click" Style="{StaticResource SubIconButton}" ToolTipService.ToolTip="Reset all sync to selected position">
                        <FontIcon FontSize="12" Glyph="&#xE8A3;" />
                    </Button>
                    <Button Click="ResetSync_Click" Style="{StaticResource SubIconButton}" ToolTipService.ToolTip="Reset sync">
                        <FontIcon FontSize="12" Glyph="&#xE72C;" />
                    </Button>
                    <Button Click="FindCurrent_Click" Style="{StaticResource SubIconButton}" ToolTipService.ToolTip="Find current sync">
                        <FontIcon FontSize="12" Glyph="&#xE721;" />
                    </Button>
                    <ToggleButton x:Name="AutoScrollToggle" Click="AutoScroll_Click" Style="{StaticResource SubIconToggle}" ToolTipService.ToolTip="Automatically scroll to current sync">
                        <FontIcon x:Name="AutoScrollIcon" FontSize="12" Glyph="&#xE895;" />
                    </ToggleButton>
                    <Button Style="{StaticResource SubIconButton}" ToolTipService.ToolTip="Subtitle menu">
                        <FontIcon FontSize="12" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource CompactMenuFlyout}">
                                <MenuFlyoutItem Click="Load_Click" Style="{StaticResource CompactMenuItem}" Text="Load subtitle…" />
                                <MenuFlyoutItem Click="Add_Click" Style="{StaticResource CompactMenuItem}" Text="Add subtitle" />
                                <MenuFlyoutItem Click="Merge_Click" Style="{StaticResource CompactMenuItem}" Text="Merge subtitles" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="EditButton" Click="Edit_Click" Style="{StaticResource SubIconButton}" ToolTipService.ToolTip="Edit subtitles">
                        <FontIcon x:Name="EditIcon" FontSize="12" Glyph="&#xE70F;" />
                    </Button>
                    <Button Click="AddRow_Click" Style="{StaticResource SubIconButton}" ToolTipService.ToolTip="Add a new row at the selected position">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                    </Button>
                    <Button Click="DeleteRow_Click" Style="{StaticResource SubIconButton}" ToolTipService.ToolTip="Delete selected row">
                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                    </Button>
                    <Button x:Name="PlayPauseButton" Click="PlayPause_Click" Style="{StaticResource SubIconButton}" ToolTipService.ToolTip="Play/pause">
                        <FontIcon x:Name="PlayPauseIcon" FontSize="12" Glyph="&#xE768;" />
                    </Button>
                    <Button Click="Save_Click" Style="{StaticResource SubIconButton}" ToolTipService.ToolTip="Save subtitle">
                        <FontIcon FontSize="12" Glyph="&#xE74E;" />
                    </Button>
                </StackPanel>
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Width="168"
                    Height="28"
                    Margin="8,0,0,0"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    CornerRadius="0"
                    FontSize="12"
                    PlaceholderText="Search"
                    TextChanged="SearchBox_TextChanged" />
            </Grid>
        </Border>

        <Border
            x:Name="TabStrip"
            Grid.Row="2"
            Background="{StaticResource GrokChromeBrush}"
            MinHeight="32">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel
                    x:Name="TrackTabs"
                    Orientation="Horizontal" />
            </ScrollViewer>
        </Border>

        <Grid
            x:Name="TableBody"
            Grid.Row="3"
            Background="{StaticResource GrokPanelBrush}"
            BorderBrush="{StaticResource GrokLineBrush}"
            BorderThickness="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                Padding="10,0"
                Background="#FF101012"
                BorderBrush="{StaticResource GrokLineBrush}"
                BorderThickness="0,1,0,1"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="122" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="122" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource GrokMutedBrush}" Text="Start" />
                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource GrokMutedBrush}" Text="~" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource GrokMutedBrush}" Text="End" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource GrokMutedBrush}" Text="Text" />
                <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource GrokMutedBrush}" Text="Sync ms" />
            </Grid>
            <ListView
                x:Name="CueList"
                Grid.Row="1"
                Padding="0"
                DoubleTapped="CueList_DoubleTapped"
                IsItemClickEnabled="True"
                ItemClick="CueList_ItemClick"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="122" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="122" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Foreground="#E6E6EA"
                                Text="{Binding StartText}" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource GrokMutedBrush}"
                                Text="~" />
                            <TextBlock
                                Grid.Column="2"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Foreground="#E6E6EA"
                                Text="{Binding EndText}" />
                            <controls:CaptionLine
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Spans="{Binding Spans}" />
                            <TextBlock
                                Grid.Column="4"
                                HorizontalAlignment="Right"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Foreground="{StaticResource GrokMutedBrush}"
                                Text="{Binding SyncText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid
                x:Name="EditStrip"
                Grid.Row="2"
                Padding="8"
                Background="#FF101012"
                BorderBrush="{StaticResource GrokLineBrush}"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource GrokMutedBrush}" Text="Start" />
                    <TextBox
                        x:Name="EditStartBox"
                        Grid.Column="1"
                        Height="28"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        CornerRadius="0"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        LostFocus="EditFields_LostFocus" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource GrokMutedBrush}" Text="End" />
                    <TextBox
                        x:Name="EditEndBox"
                        Grid.Column="3"
                        Height="28"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        CornerRadius="0"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        LostFocus="EditFields_LostFocus" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,8,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="EditBox"
                        MinHeight="36"
                        AcceptsReturn="True"
                        CornerRadius="0"
                        FontSize="12"
                        LostFocus="EditFields_LostFocus"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="StyleButton"
                        Grid.Column="1"
                        MinWidth="88"
                        Height="36"
                        VerticalAlignment="Top"
                        Click="Style_Click"
                        Content="Style"
                        CornerRadius="0" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
