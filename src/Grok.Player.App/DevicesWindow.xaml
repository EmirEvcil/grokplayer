<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Grok.Player.App.DevicesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Devices">
    <Grid
        x:Name="Root"
        Background="#FF101012"
        RequestedTheme="Dark"
        PointerMoved="EmptyArea_PointerMoved"
        PointerPressed="EmptyArea_PointerPressed"
        PointerReleased="EmptyArea_PointerReleased"
        PointerCaptureLost="EmptyArea_PointerReleased">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Background="{StaticResource GrokChromeBrush}"
            BorderBrush="{StaticResource GrokLineBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleDrag" Background="Transparent">
                <StackPanel
                    Margin="12,0,8,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Image Width="16" Height="16" Source="Assets/Logo.png" Stretch="Uniform" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource GrokAccentBrush}"
                        Text="Devices" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button
                    x:Name="PinButton"
                    Click="Pin_Click"
                    Style="{StaticResource ChromeButton}"
                    ToolTipService.ToolTip="Keep above player">
                    <FontIcon x:Name="PinIcon" FontSize="12" Glyph="&#xE840;" />
                </Button>
                <Button
                    Click="Close_Click"
                    Style="{StaticResource ChromeButton}"
                    ToolTipService.ToolTip="Close">
                    <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer
            x:Name="HomeView"
            Grid.Row="1"
            Padding="18,16,18,20"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <Border
                    Padding="12,10"
                    Background="#FF161618"
                    BorderBrush="{StaticResource GrokLineBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="2">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource GrokMutedBrush}"
                            Text="THIS PC" />
                        <TextBlock
                            x:Name="ThisPcMeta"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="Visible on the LAN"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="PairCard"
                    Padding="14"
                    Background="#FF18181C"
                    BorderBrush="#66F0C93A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource GrokAccentBrush}"
                            Text="TV IS WAITING" />
                        <TextBlock
                            x:Name="PairTitle"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Enter the code shown on the TV" />
                        <TextBox
                            x:Name="PinBox"
                            MaxLength="6"
                            PlaceholderText="6-digit code"
                            TextChanged="PinBox_TextChanged" />
                        <Button
                            x:Name="PairButton"
                            HorizontalAlignment="Left"
                            Click="Pair_Click"
                            Content="Pair"
                            Style="{StaticResource AccentActionButton}" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource GrokMutedBrush}"
                        Text="TELEVISIONS" />
                    <StackPanel x:Name="TvList" Spacing="8" />
                    <TextBlock
                        x:Name="EmptyTvs"
                        FontSize="13"
                        Foreground="{StaticResource GrokMutedBrush}"
                        Text="No TV paired yet. On the TV open Settings → Cihazlar and choose this PC."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource GrokMutedBrush}"
                                Text="SHARE FROM THIS PC" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource GrokMutedBrush}"
                                Text="Only these folders can be opened on the TV."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="AddFolder_Click"
                            Content="Add folder"
                            Style="{StaticResource SubBarButton}" />
                    </Grid>
                    <StackPanel x:Name="FolderList" Spacing="6" />
                    <TextBlock
                        x:Name="EmptyFolders"
                        FontSize="13"
                        Foreground="{StaticResource GrokMutedBrush}"
                        Text="No folders shared yet." />
                </StackPanel>

                <StackPanel x:Name="TransfersSection" Spacing="8" Visibility="Collapsed">
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource GrokMutedBrush}"
                        Text="TRANSFERS" />
                    <StackPanel x:Name="JobList" Spacing="6" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid
            x:Name="BrowseView"
            Grid.Row="1"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
                Padding="10,8,10,8"
                Background="#FF161618"
                BorderBrush="{StaticResource GrokLineBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="BrowseBack"
                        Click="BrowseBack_Click"
                        Style="{StaticResource SubIconButton}"
                        ToolTipService.ToolTip="Back">
                        <FontIcon FontSize="12" Glyph="&#xE72B;" />
                    </Button>
                    <StackPanel
                        Grid.Column="1"
                        Margin="10,0,8,0"
                        VerticalAlignment="Center"
                        Spacing="1">
                        <TextBlock
                            x:Name="BrowseTitle"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="TV folders"
                            TextTrimming="CharacterEllipsis" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel
                                x:Name="BrowseCrumbs"
                                Orientation="Horizontal"
                                Spacing="4" />
                        </ScrollViewer>
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Click="BrowseClose_Click"
                        Style="{StaticResource SubIconButton}"
                        ToolTipService.ToolTip="Close browser">
                        <FontIcon FontSize="11" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <ScrollViewer
                    Padding="12,10,12,16"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="BrowseList" Spacing="4" />
                </ScrollViewer>
                <TextBlock
                    x:Name="EmptyBrowse"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource GrokMutedBrush}"
                    Text="This folder is empty."
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
