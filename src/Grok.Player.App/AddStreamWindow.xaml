<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Grok.Player.App.AddStreamWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add stream">
    <Grid
        x:Name="Root"
        RequestedTheme="Dark"
        Background="#FF101012"
        PointerMoved="EmptyArea_PointerMoved"
        PointerPressed="EmptyArea_PointerPressed"
        PointerReleased="EmptyArea_PointerReleased"
        PointerCaptureLost="EmptyArea_PointerReleased">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Grid
            Background="{StaticResource GrokChromeBrush}"
            BorderBrush="{StaticResource GrokLineBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TitleDrag" Background="Transparent">
                <TextBlock
                    Margin="12,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource GrokAccentBrush}"
                    Text="Add stream" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button
                    x:Name="PinButton"
                    Click="Pin_Click"
                    Style="{StaticResource ChromeButton}"
                    ToolTipService.ToolTip="Keep above player">
                    <FontIcon x:Name="PinIcon" FontSize="12" Glyph="&#xE840;" />
                </Button>
                <Button
                    Click="Close_Click"
                    Style="{StaticResource ChromeButton}"
                    ToolTipService.ToolTip="Close">
                    <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="20,16,20,8">
            <TextBlock
                FontSize="13"
                Foreground="#E6E6EA"
                Text="Stream URL" />
            <TextBox
                x:Name="UrlBox"
                Height="36"
                MinHeight="36"
                Margin="0,10,0,0"
                Padding="10,6,10,6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="#FF161618"
                BorderBrush="{StaticResource GrokLineBrush}"
                BorderThickness="1"
                CornerRadius="0"
                FontSize="13"
                FontFamily="Segoe UI"
                Foreground="#FFE6E6EA"
                PlaceholderText="https://example.com/live.m3u8" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10">
            <Button
                Width="88"
                Height="30"
                Click="Add_Click"
                Content="Add"
                Style="{StaticResource SubBarButton}" />
            <Button
                Width="88"
                Height="30"
                Click="Play_Click"
                Content="Play"
                Style="{StaticResource SubBarButton}" />
        </StackPanel>
    </Grid>
</Window>
