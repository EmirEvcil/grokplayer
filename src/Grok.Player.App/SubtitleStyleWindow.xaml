<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Grok.Player.App.SubtitleStyleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Subtitle style">
    <Grid
        x:Name="Root"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        RequestedTheme="Dark"
        Background="#FF101012"
        PointerMoved="EmptyArea_PointerMoved"
        PointerPressed="EmptyArea_PointerPressed"
        PointerReleased="EmptyArea_PointerReleased"
        PointerCaptureLost="EmptyArea_PointerReleased">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Grid
            Background="{StaticResource GrokChromeBrush}"
            BorderBrush="{StaticResource GrokLineBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="TitleDrag"
                Background="Transparent">
                <TextBlock
                    Margin="12,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource GrokAccentBrush}"
                    Text="Subtitle style" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="0,0,8,0" Orientation="Horizontal">
                <Button
                    x:Name="PinButton"
                    Click="Pin_Click"
                    Style="{StaticResource ChromeButton}"
                    ToolTipService.ToolTip="Keep above player">
                    <FontIcon x:Name="PinIcon" FontSize="12" Glyph="&#xE840;" />
                </Button>
                <Button
                    Click="Close_Click"
                    Style="{StaticResource ChromeButton}"
                    ToolTipService.ToolTip="Close">
                    <FontIcon FontSize="12" Glyph="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer
            x:Name="BodyScroll"
            Grid.Row="1"
            Padding="16,12,16,8"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <Border
                    Padding="12,10"
                    Background="{StaticResource GrokPanelBrush}"
                    BorderBrush="{StaticResource GrokLineBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="11" Foreground="{StaticResource GrokMutedBrush}" Text="Preview" />
                        <TextBlock
                            x:Name="PreviewText"
                            FontSize="18"
                            Foreground="#FFE6E6EA"
                            Text="Sample subtitle"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock FontSize="11" Foreground="{StaticResource GrokMutedBrush}" Text="Color" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="PreviewSwatch"
                            Width="40"
                            Height="36"
                            Background="White"
                            BorderBrush="{StaticResource GrokLineBrush}"
                            BorderThickness="1" />
                        <TextBox
                            x:Name="HexBox"
                            Grid.Column="1"
                            Height="36"
                            Padding="10,6"
                            VerticalAlignment="Center"
                            CornerRadius="0"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="13"
                            LostFocus="HexBox_LostFocus"
                            Text="#FFFFFF" />
                    </Grid>
                    <Grid x:Name="Palette" ColumnSpacing="5" />
                    <Grid Margin="0,4,0,0" RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#FF8080" Text="R" />
                        <Slider x:Name="RedSlider" Grid.Column="1" Maximum="255" Minimum="0" StepFrequency="1" ValueChanged="Rgb_ValueChanged" />
                        <TextBlock x:Name="RedValue" Grid.Column="2" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource GrokMutedBrush}" Text="255" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="11" Foreground="#80FF80" Text="G" />
                        <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Maximum="255" Minimum="0" StepFrequency="1" ValueChanged="Rgb_ValueChanged" />
                        <TextBlock x:Name="GreenValue" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource GrokMutedBrush}" Text="255" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" FontSize="11" Foreground="#8080FF" Text="B" />
                        <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Maximum="255" Minimum="0" StepFrequency="1" ValueChanged="Rgb_ValueChanged" />
                        <TextBlock x:Name="BlueValue" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource GrokMutedBrush}" Text="255" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock FontSize="11" Foreground="{StaticResource GrokMutedBrush}" Text="Formatting" />
                    <DropDownButton
                        x:Name="TagDrop"
                        MinHeight="36"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="12,6"
                        Background="#FF161618"
                        BorderBrush="{StaticResource GrokLineBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Foreground="#FFE6E6EA"
                        Click="TagDrop_Click">
                        <DropDownButton.Content>
                            <TextBlock x:Name="TagSummary" Text="Select tags" />
                        </DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <Flyout x:Name="TagFlyout" Placement="Bottom">
                                <StackPanel x:Name="TagList" MinWidth="220" Spacing="2" />
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <TextBlock
                        x:Name="TagHint"
                        FontSize="11"
                        Foreground="{StaticResource GrokMutedBrush}"
                        Text="Multiple tags can stay selected." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid
            Grid.Row="2"
            Padding="12,0"
            Background="{StaticResource GrokChromeBrush}"
            BorderBrush="{StaticResource GrokLineBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Width="88"
                    Height="30"
                    Click="Apply_Click"
                    Content="Apply"
                    Style="{StaticResource AccentActionButton}" />
                <Button
                    Width="88"
                    Height="30"
                    Click="Ok_Click"
                    Content="OK"
                    Style="{StaticResource SubBarButton}" />
                <Button
                    Width="88"
                    Height="30"
                    Click="Cancel_Click"
                    Content="Cancel"
                    Style="{StaticResource SubBarButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
