<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Grok.Player.App.ResumeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Resume playback">
    <Grid
        x:Name="Root"
        RequestedTheme="Dark"
        Background="#FF101012"
        PointerMoved="EmptyArea_PointerMoved"
        PointerPressed="EmptyArea_PointerPressed"
        PointerReleased="EmptyArea_PointerReleased"
        PointerCaptureLost="EmptyArea_PointerReleased">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>
        <Grid
            Background="{StaticResource GrokChromeBrush}"
            BorderBrush="{StaticResource GrokLineBrush}"
            BorderThickness="0,0,0,1">
            <Grid x:Name="TitleDrag" Background="Transparent">
                <TextBlock
                    Margin="12,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource GrokAccentBrush}"
                    Text="Resume playback" />
            </Grid>
        </Grid>
        <TextBlock
            x:Name="MessageText"
            Grid.Row="1"
            Margin="20,18"
            VerticalAlignment="Center"
            MinHeight="64"
            FontSize="14"
            FontFamily="Segoe UI"
            Foreground="#FFE6E6EA"
            TextWrapping="Wrap"
            Text="Continue from the last position?" />
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10">
            <Button
                Width="108"
                Height="30"
                Click="Continue_Click"
                Content="Continue"
                Style="{StaticResource SubBarButton}" />
            <Button
                Width="108"
                Height="30"
                Click="StartOver_Click"
                Content="Start over"
                Style="{StaticResource SubBarButton}" />
        </StackPanel>
    </Grid>
</Window>
