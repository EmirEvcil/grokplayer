<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Grok.Player.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="GrokAccentColor">#F0C93A</Color>
            <Color x:Key="GrokPinkColor">#D9899C</Color>
            <Color x:Key="GrokInkColor">#101012</Color>
            <SolidColorBrush x:Key="GrokAccentBrush" Color="{StaticResource GrokAccentColor}" />
            <SolidColorBrush x:Key="GrokPinkBrush" Color="{StaticResource GrokPinkColor}" />
            <SolidColorBrush x:Key="GrokInkBrush" Color="{StaticResource GrokInkColor}" />
            <SolidColorBrush x:Key="GrokMutedBrush" Color="#9A9AA2" />
            <SolidColorBrush x:Key="GrokLineBrush" Color="#FF3A3A42" />
            <SolidColorBrush x:Key="GrokPanelBrush" Color="#FF1C1C20" />
            <SolidColorBrush x:Key="GrokChromeBrush" Color="#FF161618" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#FF2A2A30" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#FF323238" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#FF323238" />
            <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#FF1C1C20" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFF0C93A" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFF0C93A" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFE0B82E" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#66F0C93A" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFF0C93A" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFF6DC6E" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFE0B82E" />
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#66F0C93A" />
            <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#FFF0C93A" />
            <SolidColorBrush x:Key="SliderContainerBackground" Color="Transparent" />
            <SolidColorBrush x:Key="SliderContainerBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="SliderContainerBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="SliderContainerBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="DropDownButtonBackground" Color="#FF161618" />
            <SolidColorBrush x:Key="DropDownButtonBackgroundPointerOver" Color="#FF1C1C20" />
            <SolidColorBrush x:Key="DropDownButtonBackgroundPressed" Color="#FF161618" />
            <SolidColorBrush x:Key="DropDownButtonBorderBrush" Color="#FF3A3A42" />
            <SolidColorBrush x:Key="DropDownButtonForeground" Color="#FFE6E6EA" />

            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="MenuFlyoutItemCornerRadius">0</CornerRadius>
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FF1C1C20" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#FF3A3A42" />
            <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">1</Thickness>
            <Thickness x:Key="MenuFlyoutPresenterThemePadding">0,4</Thickness>
            <x:Double x:Key="MenuFlyoutPresenterThemeMinWidth">268</x:Double>
            <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#1AF0C93A" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#28F0C93A" />
            <SolidColorBrush x:Key="MenuFlyoutItemBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#FFE6E6EA" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FFF0C93A" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#FFF0C93A" />
            <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#66707078" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundPointerOver" Color="#1AF0C93A" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundPressed" Color="#28F0C93A" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemForeground" Color="#FFE6E6EA" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundPointerOver" Color="#FFF0C93A" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemForegroundPressed" Color="#FFF0C93A" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="#FF9A9AA2" />
            <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPointerOver" Color="#FFF0C93A" />
            <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#FF3A3A42" />
            <SolidColorBrush x:Key="ToggleMenuFlyoutItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleMenuFlyoutItemBackgroundPointerOver" Color="#1AF0C93A" />
            <SolidColorBrush x:Key="ToggleMenuFlyoutItemBackgroundPressed" Color="#28F0C93A" />
            <SolidColorBrush x:Key="ToggleMenuFlyoutItemForeground" Color="#FFE6E6EA" />
            <SolidColorBrush x:Key="ToggleMenuFlyoutItemForegroundPointerOver" Color="#FFF0C93A" />
            <SolidColorBrush x:Key="ToggleMenuFlyoutItemCheckGlyphForeground" Color="#FFF0C93A" />

            <Style TargetType="MenuFlyoutPresenter">
                <Setter Property="Background" Value="{StaticResource GrokPanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GrokLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="0,4" />
                <Setter Property="MinWidth" Value="268" />
            </Style>

            <Style x:Key="CompactMenuFlyout" TargetType="MenuFlyoutPresenter">
                <Setter Property="Background" Value="#FF1C1C20" />
                <Setter Property="BorderBrush" Value="{StaticResource GrokLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="0,2" />
                <Setter Property="MinWidth" Value="128" />
                <Setter Property="MaxWidth" Value="168" />
            </Style>

            <Style x:Key="CompactMenuItem" TargetType="MenuFlyoutItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#E6E6EA" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,4,10,4" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuFlyoutItem">
                            <Grid x:Name="LayoutRoot" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="#22FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="#33FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ItemText.Foreground" Value="#66707078" />
                                                <Setter Target="LayoutRoot.Background" Value="Transparent" />
                                                <Setter Target="LayoutRoot.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ContentPresenter Width="14" VerticalAlignment="Center" Content="{TemplateBinding Icon}" />
                                    <TextBlock
                                        x:Name="ItemText"
                                        VerticalAlignment="Center"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{TemplateBinding Foreground}"
                                        Text="{TemplateBinding Text}" />
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SubIconButton" TargetType="Button">
                <Setter Property="Background" Value="#FF161618" />
                <Setter Property="Foreground" Value="#E6E6EA" />
                <Setter Property="BorderBrush" Value="{StaticResource GrokLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="SubIconToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="#FF161618" />
                <Setter Property="Foreground" Value="#E6E6EA" />
                <Setter Property="BorderBrush" Value="{StaticResource GrokLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="SubBarButton" TargetType="Button">
                <Setter Property="Background" Value="#FF161618" />
                <Setter Property="Foreground" Value="#E6E6EA" />
                <Setter Property="BorderBrush" Value="{StaticResource GrokLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="AccentActionButton" TargetType="Button" BasedOn="{StaticResource SubBarButton}">
                <Setter Property="Foreground" Value="{StaticResource GrokAccentBrush}" />
                <Setter Property="BorderBrush" Value="#66F0C93A" />
            </Style>

            <Style x:Key="JobIconButton" TargetType="Button" BasedOn="{StaticResource SubIconButton}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
            </Style>

            <Style x:Key="SubBarToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="#FF161618" />
                <Setter Property="Foreground" Value="#E6E6EA" />
                <Setter Property="BorderBrush" Value="{StaticResource GrokLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="ChromeButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Foreground" Value="#D0D0D4" />
            </Style>

            <Style x:Key="PanelTabButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource GrokMutedBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverFill.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverFill.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Rectangle
                                    x:Name="HoverFill"
                                    Fill="#1AF0C93A"
                                    Opacity="0" />
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PanelChromeButton" TargetType="Button">
                <Setter Property="Background" Value="#FF161618" />
                <Setter Property="Foreground" Value="#E6E6EA" />
                <Setter Property="BorderBrush" Value="{StaticResource GrokLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="HoverFill.Opacity" Value="0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverFill.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverFill.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0" />
                                <Rectangle
                                    x:Name="HoverFill"
                                    Margin="{TemplateBinding BorderThickness}"
                                    Fill="#40F0C93A"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PanelRadioCheck" TargetType="CheckBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#E6E6EA" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel
                                x:Name="LayoutRoot"
                                Background="Transparent"
                                Orientation="Horizontal"
                                Spacing="8">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Stroke" Value="{StaticResource GrokAccentBrush}" />
                                                <Setter Target="Label.Foreground" Value="{StaticResource GrokAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Stroke" Value="{StaticResource GrokAccentBrush}" />
                                                <Setter Target="Label.Foreground" Value="{StaticResource GrokAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Dot.Opacity" Value="1" />
                                                <Setter Target="Ring.Stroke" Value="{StaticResource GrokAccentBrush}" />
                                                <Setter Target="Label.Foreground" Value="{StaticResource GrokAccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid
                                    x:Name="Root"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center">
                                    <Ellipse
                                        x:Name="Ring"
                                        Width="14"
                                        Height="14"
                                        Fill="Transparent"
                                        Stroke="{StaticResource GrokMutedBrush}"
                                        StrokeThickness="1.5" />
                                    <Ellipse
                                        x:Name="Dot"
                                        Width="8"
                                        Height="8"
                                        Fill="{StaticResource GrokAccentBrush}"
                                        Opacity="0" />
                                </Grid>
                                <ContentPresenter
                                    x:Name="Label"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SquareThumb" TargetType="Thumb">
                <Setter Property="Background" Value="{StaticResource GrokAccentBrush}" />
                <Setter Property="BorderBrush" Value="#FF1A1A1C" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border
                                Width="10"
                                Height="16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SquareSlider" TargetType="Slider">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="IsThumbToolTipEnabled" Value="False" />
                <Setter Property="Foreground" Value="{StaticResource GrokAccentBrush}" />
                <Setter Property="Background" Value="#FF3A3A42" />
                <Setter Property="Height" Value="22" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid x:Name="RootGrid">
                                <Grid x:Name="SliderContainer" Background="Transparent" Control.IsTemplateFocusTarget="True">
                                    <Grid x:Name="HorizontalTemplate" Background="Transparent" MinHeight="22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Rectangle
                                            x:Name="HorizontalTrackRect"
                                            Grid.Row="1"
                                            Grid.ColumnSpan="3"
                                            Height="3"
                                            Fill="{TemplateBinding Background}" />
                                        <Rectangle
                                            x:Name="HorizontalDecreaseRect"
                                            Grid.Row="1"
                                            Height="3"
                                            Fill="{TemplateBinding Foreground}" />
                                        <Thumb
                                            x:Name="HorizontalThumb"
                                            Grid.Row="0"
                                            Grid.RowSpan="3"
                                            Grid.Column="1"
                                            Style="{StaticResource SquareThumb}"
                                            DataContext="{TemplateBinding Value}" />
                                    </Grid>
                                    <Grid x:Name="VerticalTemplate" Background="Transparent" MinWidth="22" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle
                                            x:Name="VerticalTrackRect"
                                            Grid.Column="1"
                                            Grid.RowSpan="3"
                                            Width="3"
                                            Fill="{TemplateBinding Background}" />
                                        <Rectangle
                                            x:Name="VerticalDecreaseRect"
                                            Grid.Column="1"
                                            Width="3"
                                            Fill="{TemplateBinding Foreground}" />
                                        <Thumb
                                            x:Name="VerticalThumb"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="3"
                                            Grid.Row="1"
                                            Style="{StaticResource SquareThumb}"
                                            DataContext="{TemplateBinding Value}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="VerticalSquareSlider" TargetType="Slider">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="IsThumbToolTipEnabled" Value="False" />
                <Setter Property="Orientation" Value="Vertical" />
                <Setter Property="IsDirectionReversed" Value="False" />
                <Setter Property="Foreground" Value="{StaticResource GrokAccentBrush}" />
                <Setter Property="Background" Value="#FF3A3A42" />
                <Setter Property="Width" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid x:Name="RootGrid" Background="Transparent">
                                <Grid x:Name="SliderContainer" Background="Transparent" Control.IsTemplateFocusTarget="True">
                                    <Grid x:Name="HorizontalTemplate" Background="Transparent" MinHeight="22" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Rectangle x:Name="HorizontalTrackRect" Grid.Row="1" Grid.ColumnSpan="3" Height="3" Fill="{TemplateBinding Background}" />
                                        <Rectangle x:Name="HorizontalDecreaseRect" Grid.Row="1" Height="3" Fill="{TemplateBinding Foreground}" />
                                        <Thumb x:Name="HorizontalThumb" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Style="{StaticResource SquareThumb}" />
                                    </Grid>
                                    <Grid x:Name="VerticalTemplate" Background="Transparent" MinWidth="22">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle
                                            x:Name="VerticalTrackRect"
                                            Grid.Column="1"
                                            Grid.RowSpan="3"
                                            Width="3"
                                            Fill="{TemplateBinding Background}" />
                                        <Rectangle
                                            x:Name="VerticalDecreaseRect"
                                            Grid.Column="1"
                                            Width="3"
                                            Fill="{TemplateBinding Foreground}" />
                                        <Thumb
                                            x:Name="VerticalThumb"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="3"
                                            Grid.Row="1"
                                            Style="{StaticResource SquareThumb}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TransportIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Foreground" Value="#E6E6EA" />
            </Style>

            <Style x:Key="TransportLabelButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="MinWidth" Value="52" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Foreground" Value="#C8C8CE" />
            </Style>

            <Style x:Key="PlaylistList" TargetType="ListView">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,4,0,8" />
                <Setter Property="IsItemClickEnabled" Value="True" />
                <Setter Property="SelectionMode" Value="Single" />
            </Style>

            <Style x:Key="PlaylistItemContainer" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid x:Name="Root" Background="Transparent" Padding="14,9,12,9">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#18FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#22FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#1AF0C93A" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#28F0C93A" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#33F0C93A" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#28F0C93A" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    HorizontalAlignment="Stretch"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
